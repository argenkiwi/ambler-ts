{
  "tasks": {
    "dev": "deno run --watch walks/counter.ts",
    "counter": "deno run walks/counter.ts",
    "init": "deno run --allow-read --allow-write walks/init.ts",
    "clone": "deno run --allow-read --allow-write walks/clone.ts",
    "chat": "deno run --allow-net walks/chat.ts",
    "test": "deno test nodes/tests walks/tests",
    "check": "deno check ambler.ts nodes walks utils",
    "lint": "deno lint && deno fmt --check ambler.ts nodes walks utils"
  },
  "lint": {
    "exclude": ["notes/", ".agents/"],
    "rules": { "include": ["no-explicit-any"] }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "ollama": "npm:ollama@^0.6.3"
  }
}
